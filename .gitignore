# Env files (never commit secrets)
.env
.env.local
.env.development.local
.env.production.local

# Generated dashboard static export — see README.md: "public/ is a build
# artifact ... wiped and regenerated by `npm run build`. Don't hand-edit it."
node-ingestion/public/

# Next.js build output
node-ingestion/dashboard/.next/
node-ingestion/dashboard/out/
node-ingestion/dashboard/*.tsbuildinfo
node-ingestion/dashboard/next-env.d.ts

# Narrative/progressive docs — kept locally, not committed (README.md is
# the one doc that IS committed).
/DESIGN.md
/JOURNEY.md
/spec.md
/STRESS_TEST.md
