# Gemini model used by the inversion agent (Step 4)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_TOKENS=2500

# Agent selection: auto | llm | offline
#   auto    -> use Gemini if GEMINI_API_KEY is set, else the offline optimizer
#   llm     -> force Gemini
#   offline -> force the deterministic pattern-search test double (no API key)
AGENT_MODE=auto

# Same auto|llm|offline shape, for the per-method Interpretation Agent and
# the multi-method Joint Interpretation capstone. Independent of AGENT_MODE
# so the inversion solver and the interpretation stage can be toggled separately.
INTERPRETER_MODE=auto

# Same shape again, for the LITHOLOGY classifier — but defaults to "offline",
# not "auto": lithology-from-logs is a well-benchmarked supervised problem a
# correctly-configured Random Forest already solves well, so the classical
# baseline is the recommended PRODUCTION default even when a Gemini key is
# present. Set CLASSIFIER_MODE=llm to demo the agentic path instead.
CLASSIFIER_MODE=offline

# Inversion loop controls
L2_TOLERANCE=0.05            # relative misfit ||d_obs-d_pred|| / ||d_obs||
MAX_ITERATIONS=6            # LLM ceiling (one-shot scipy inversion: ~1-2 calls)
OFFLINE_MAX_ITERATIONS=200   # ceiling for the offline optimizer test double
SANDBOX_TIMEOUT_S=20         # headroom for the model's in-script scipy fit

# If set, model code is executed by the remote sandbox service (see
# docker-compose). Leave empty to run the sandbox locally in-process.
SANDBOX_URL=

# The dashboard's Upload Data page (/upload) has an opt-in AI Cleaning Agent
# for messy raw uploads (unlabeled columns, outlier spikes, drift, mixed
# units) — app/agent/data_cleaner.py, POST /clean. UNLIKE every other stage
# above, this one has NO offline fallback (see its module docstring for why)
# — it requires GEMINI_API_KEY and returns a clear 503 without one, rather
# than pretending to clean data it can't.
