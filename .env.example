# Copy to .env for `docker compose up`.

# --- Agent ---
# auto = use Gemini if GEMINI_API_KEY is set, else the offline optimizer.
# The inversion/interpretation pipeline runs end-to-end with NO key on
# AGENT_MODE=offline. The one exception is the dashboard Upload page's
# opt-in AI Cleaning Agent (/upload) — it has no offline fallback by design
# (see DESIGN.md 14.7) and simply isn't usable without a key; everything
# else in the platform still works with GEMINI_API_KEY empty.
AGENT_MODE=auto
GEMINI_API_KEY=
# gemini-2.5-flash / -flash-lite both hit the 20-req/day free-tier cap during
# development; the free-tier quota is tracked PER MODEL, so the Gemini 3 line
# has its own separate bucket (see JOURNEY.md Phase 11 addendum).
GEMINI_MODEL=gemini-3.1-flash-lite

# Same auto|llm|offline shape, applied independently per stage, so the solver
# and the interpretation stages can be toggled separately.
#   INTERPRETER_MODE - per-method Interpretation Agent + Joint Interpretation
#   CLASSIFIER_MODE  - the LITHOLOGY classifier. Defaults to `offline` on
#                      purpose: a Random Forest already beats the LLM here
#                      (DESIGN.md 13.5), so the classical path is the
#                      recommended production default even WITH a key set.
INTERPRETER_MODE=auto
CLASSIFIER_MODE=offline

# --- Inversion loop ---
L2_TOLERANCE=0.05
MAX_ITERATIONS=6
OFFLINE_MAX_ITERATIONS=200
SANDBOX_TIMEOUT_S=20

# --- Alerts (optional) ---
# POST each finished inversion here (e.g. a Slack incoming webhook).
ALERT_WEBHOOK_URL=
