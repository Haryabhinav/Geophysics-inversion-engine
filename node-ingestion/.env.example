# HTTP port for the Fastify ingestion server
HTTP_PORT=3000

# WebSocket URL of the FastAPI agent backend
AGENT_WS_URL=ws://localhost:8000/ws/inversion-stream

# Reconnection backoff (milliseconds)
WS_RECONNECT_BASE_MS=1000
WS_RECONNECT_MAX_MS=30000

# Max jobs buffered in memory while the backend is unavailable
MAX_BUFFERED_JOBS=1000

# Postgres connection string. If unset, persistence is disabled (results are
# still logged and alerted).
DATABASE_URL=postgres://afie:afie@localhost:5432/inversions

# Optional: POST each finished inversion here (e.g. a Slack incoming webhook).
ALERT_WEBHOOK_URL=
